{
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "sayulita-restaurant.vercel.app" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://www.sayulitamiamor.com/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "sayulita-restaurant.vercel.app"
        }
      ]
    },
    { "source": "/en/reservas", "destination": "/en/", "permanent": true },
    { "source": "/bg/reservas", "destination": "/bg/", "permanent": true },
    { "source": "/es/reservas", "destination": "/es/", "permanent": true },
    { "source": "/reservas",    "destination": "/en/", "permanent": true }
  ]
}
